#!/bin/bash
#----------------------------------------------------------------------------
# HARMONY paper tests, scenario gpu1: compute-0-2, GPU only.
#
# Nodes:
#   compute-0-2  32 cores, 1 GPU (RTX A2000), 28 GB
#
# Submit from the HARMONY directory:
#   qsub scripts/pbs/paper_gpu1.pbs
#   qsub -v BENCHES=map scripts/pbs/paper_gpu1.pbs
#   qsub -v BENCHES=lu,RUNS=1,OUT_DIR=results/pilot scripts/pbs/paper_gpu1.pbs
#
# Variables: see scripts/pbs/paper_run.sh. Statistics: scripts/pbs/paper_stats.sh
#----------------------------------------------------------------------------
#PBS -N HARMONY_gpu1
#PBS -j oe
#PBS -l select=1:host=compute-0-2:ncpus=32:ngpus=1:mem=28gb:mpiprocs=1
#PBS -l place=scatter

set -euo pipefail
# shellcheck disable=SC1091
source "${HARMONY_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}/scripts/pbs/job_env.sh"

SCENARIO=gpu1
# shellcheck disable=SC1091
source "$HARMONY_ROOT/scripts/pbs/paper_run.sh"
paper_main
