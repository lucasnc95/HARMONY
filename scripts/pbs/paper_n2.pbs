#!/bin/bash
#----------------------------------------------------------------------------
# HARMONY paper tests, scenario n2: compute-0-2 and compute-3-4, GPU and CPU on each.
#
# Nodes:
#   compute-0-2  32 cores, 1 GPU, 28 GB
#   compute-3-4  16 cores, 1 GPU, 7 GB (free memory of the node)
#
# Submit from the HARMONY directory:
#   qsub scripts/pbs/paper_n2.pbs
#   qsub -v BENCHES=map scripts/pbs/paper_n2.pbs
#   qsub -v BENCHES=lu,RUNS=1,OUT_DIR=results/pilot scripts/pbs/paper_n2.pbs
#
# Variables: see scripts/pbs/paper_run.sh. Statistics: scripts/pbs/paper_stats.sh
#----------------------------------------------------------------------------
#PBS -N HARMONY_n2
#PBS -j oe
#PBS -l select=1:host=compute-0-2:ncpus=32:ngpus=1:mem=28gb:mpiprocs=1+1:host=compute-3-4:ncpus=16:ngpus=1:mem=7gb:mpiprocs=1
#PBS -l place=scatter

set -euo pipefail
# shellcheck disable=SC1091
source "${HARMONY_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}/scripts/pbs/job_env.sh"

SCENARIO=n2
# shellcheck disable=SC1091
source "$HARMONY_ROOT/scripts/pbs/paper_run.sh"
paper_main
